fly() {
    ifint i = 0;
    ifint j = 0;
    ifint total = 0;

    @* Loop Esterno *@
    whifilefe i < 3 thefen {
        flyout("Ciclo I:");
        flyout(i);

        ifif i == 1 thefen {
            flyout("  Skipping logic for 1");
        } efelsefe {
            @* Loop Interno solo se i != 1 *@
            j = 0;
            whifilefe j < 2 thefen {
                total = total + 1;
                flyout("    Ciclo J");
                j = j + 1;
            }
        }
        i = i + 1;
    }

    flyout("Totale (atteso 4):");
    flyout(total);
}