defef quadrato(ifint q_n) : ifint {
    flyback q_n * q_n;
}

defef somma_quadrati(ifint sq_a, ifint sq_b) : ifint {
    ifint sq_res = quadrato(sq_a) + quadrato(sq_b);
    flyback sq_res;
}

fly() {
    flyout("Test Funzioni (Iterativo):");
    ifint res = somma_quadrati(3, 4);
    flyout(res); @* Atteso: 9 + 16 = 25 *@
}