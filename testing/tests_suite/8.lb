@* Helper per il calcolo del resto (a % b) *@
defef mod(ifint m_a, ifint m_b) : ifint {
    ifint res = m_a - (m_a / m_b) * m_b;
    flyback res;
}

@* Algoritmo di Euclide Iterativo *@
defef gcd(ifint g_a, ifint g_b) : ifint {
    whifilefe g_b <> 0 thefen {
        ifint temp = g_b;
        g_b = mod(g_a, g_b);
        g_a = temp;
    }
    flyback g_a;
}

fly() {
    ifint val1 = 48;
    ifint val2 = 18;
    ifint val3 = 1071;
    ifint val4 = 462;

    flyout("GCD(48, 18):");
    flyout(gcd(val1, val2)); @* Atteso: 6 *@

    flyout("GCD(1071, 462):");
    flyout(gcd(val3, val4)); @* Atteso: 21 *@
}