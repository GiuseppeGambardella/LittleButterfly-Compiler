defef modulo(ifint m_a, ifint m_b) : ifint {
    ifint m_res = m_a - (m_a / m_b) * m_b;
    flyback m_res;
}

defef is_prime(ifint p_n) : bofoofol {
    ifif p_n <= 1 thefen { flyback false; }

    ifint p_i = 2;
    @* Controllo fino a n/2 per semplicità *@
    whifilefe p_i < p_n / 2 + 1 thefen {
        ifif modulo(p_n, p_i) == 0 thefen {
            flyback false;
        }
        p_i = p_i + 1;
    }
    flyback true;
}

fly() {
    ifint check_val = 17;
    ifif is_prime(check_val) thefen {
        flyout(check_val);
        flyout("e' primo!");
    } efelsefe {
        flyout("Non e' primo");
    }
}