defef is_even(ifint ev_n) : bofoofol {
    @* Simuliamo il modulo 2: se (n/2)*2 == n, allora è pari *@
    ifint half = ev_n / 2;
    ifif (half * 2) == ev_n thefen {
        flyback true;
    }
    flyback false;
}

fly() {
    ifint n = 27;
    ifint steps = 0;

    flyout("Start Collatz for 27:");

    whifilefe n > 1 thefen {
        ifif is_even(n) thefen {
            n = n / 2;
        } efelsefe {
            n = 3 * n + 1;
        }

        @* Stampa solo alcuni passi per non intasare l'output *@
        ifif n < 10 thefen {
            flyout(n);
        }

        steps = steps + 1;
    }

    flyout("Total Steps:");
    flyout(steps); @* Per 27 dovrebbero essere 111 passi *@
}