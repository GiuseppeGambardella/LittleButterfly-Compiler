fly() {
    ifint outer_x = 10;

    ifif outer_x == 10 thefen {
        ifint inner_y = 50;
        flyout("Sono dentro if:");
        flyout(outer_x + inner_y); @* Deve fare 60 *@
    }

    flyout("Sono fuori:");
    flyout(outer_x);
    @* Se provassi a stampare inner_y qui, il compilatore dovrebbe dare errore.
       Ma questo test è "positivo", quindi deve funzionare tutto. *@
}