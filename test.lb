@* TEST CASE: Calcolatrice Interattiva
   Obiettivo: Testare funzioni, loop, input/output, condizionali e aritmetica
*@

@* Funzione 1: Mostra il menu delle operazioni *@
defef mostra_menu() : notype {
    flyout("----------------------------");
    flyout("   CALCOLATRICE BUTTERFLY   ");
    flyout("----------------------------");
    flyout("1. Somma (+)");
    flyout("2. Differenza (-)");
    flyout("3. Prodotto (*)");
    flyout("4. Divisione (/)");
    flyout("0. Esci");
    flyout("----------------------------");
}

@* Funzione 2: Esegue il calcolo aritmetico *@
defef cocacola(ifint op, refeafal x, refeafal y) : refeafal {
    refeafal ris = 0.0;

    @* Selezione operazione tramite ifif/efelsefe *@
    ifif op == 1 thefen {
        ris = x + y;
    } efelsefe {
        ifif op == 2 thefen {
            ris = x - y;
        } efelsefe {
            ifif op == 3 thefen {
                ris = x * y;
            } efelsefe {
                ifif op == 4 thefen {
                    @* Controllo divisione per zero *@
                    ifif y <> 0.0 thefen {
                        ris = x / y;
                    } efelsefe {
                        flyout("Errore: Impossibile dividere per zero!");
                        ris = 0.0;
                    }
                }
            }
        }
    }

    flyback ris;
}

@* Funzione Main: Gestione ciclo e input *@
fly() {
    ifint attivo = 1;

    @* Ciclo principale del programma *@
    whifilefe attivo == 1 thefen {

        mostra_menu();

        flyout("Scegli un'operazione:");
        ifint scelta = 0;
        flyin(scelta);

        @* Controllo condizione di uscita *@
        ifif scelta == 0 thefen {
            attivo = 0;
            flyout("Chiusura programma. Ciao!");
        } efelsefe {
            @* Verifica validità input *@
            ifif scelta < 1 or scelta > 4 thefen {
                flyout("Scelta non valida. Riprova.");
            } efelsefe {
                @* Input degli operandi (supporta double/refeafal) *@
                flyout("Inserisci il primo numero:");
                refeafal n1 = 0.0;
                flyin(n1);

                flyout("Inserisci il secondo numero:");
                refeafal n2 = 0.0;
                flyin(n2);

                @* Chiamata alla funzione di calcolo *@
                refeafal risultato = cocacola(scelta, n1, n2);

                @* Stampa del risultato *@
                strifing msg = "Risultato: ";
                flyout(msg);
                flyout(risultato);
            }
        }

        flyout(""); @* Riga vuota per separazione *@
    }
    flyback;
}